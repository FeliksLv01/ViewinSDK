{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:viewin:snapshot:0.1",
  "title": "Viewin Snapshot 0.1",
  "type": "object",
  "required": [
    "protocolVersion",
    "snapshotId",
    "sessionId",
    "capturedAt",
    "source",
    "target",
    "capabilities",
    "capture",
    "windows",
    "nodes",
    "relations",
    "images"
  ],
  "properties": {
    "protocolVersion": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": [
        "runtime",
        "fixture"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "platform",
        "deviceId",
        "deviceName",
        "appId",
        "appName",
        "appVersion",
        "osVersion",
        "buildType",
        "frameworks"
      ],
      "properties": {
        "platform": {
          "enum": [
            "ios",
            "android"
          ]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "deviceName": {
          "type": "string"
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "appName": {
          "type": "string"
        },
        "appVersion": {
          "type": "string"
        },
        "osVersion": {
          "type": "string"
        },
        "buildType": {
          "enum": [
            "debug",
            "internalRelease",
            "unknown"
          ]
        },
        "frameworks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameworkVersion"
          }
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "startedAt",
        "completedAt",
        "completeness",
        "consistency",
        "warnings"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "consistency": {
          "enum": [
            "bestEffort",
            "stable",
            "unknown"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      },
      "additionalProperties": true
    },
    "windows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/window"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "size": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "geometry": {
      "type": "object",
      "required": [
        "localBounds",
        "frameInWindow",
        "cornersInWindow"
      ],
      "properties": {
        "localBounds": {
          "$ref": "#/$defs/rect"
        },
        "frameInWindow": {
          "$ref": "#/$defs/rect"
        },
        "cornersInWindow": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "clipInWindow": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 3,
              "items": {
                "$ref": "#/$defs/point"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "visibility": {
      "type": "object",
      "required": [
        "hidden",
        "alpha"
      ],
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "frameworkVersion": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "nodeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "property": {
      "type": "object",
      "required": [
        "id",
        "title",
        "value",
        "availability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "value": {},
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "presentation": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "sectionId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sectionTitle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "enumType": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "propertyGroup": {
      "type": "object",
      "required": [
        "id",
        "title",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        }
      },
      "additionalProperties": true
    },
    "sourceLocation": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "column": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "window": {
      "type": "object",
      "required": [
        "id",
        "title",
        "size",
        "unit",
        "pixelsPerUnit",
        "rootNodeIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/size"
        },
        "unit": {
          "enum": [
            "pt",
            "dp"
          ]
        },
        "pixelsPerUnit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rootNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "screenshotId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "windowId",
        "childIds",
        "framework",
        "kind",
        "typeName",
        "name",
        "identifiers",
        "visibility",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "windowId": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "childIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "typeName": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "geometry": {
          "anyOf": [
            {
              "$ref": "#/$defs/geometry"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propertyGroup"
          }
        },
        "sourceLocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "imageId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Solo screenshot resource ID, excluding children."
        },
        "groupImageId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Group screenshot resource ID, including descendants; used when collapsed."
        }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": [
        "fromNodeId",
        "toNodeId",
        "kind"
      ],
      "properties": {
        "fromNodeId": {
          "type": "string",
          "minLength": 1
        },
        "toNodeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "required": [
        "id",
        "path",
        "mimeType",
        "pixelWidth",
        "pixelHeight"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+[^/]$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "pixelWidth": {
          "type": "integer",
          "minimum": 1
        },
        "pixelHeight": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  }
}
